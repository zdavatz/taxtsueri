<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:eCH-0007="http://www.ech.ch/xmlns/eCH-0007/6" xmlns:eCH-0010="http://www.ech.ch/xmlns/eCH-0010/8" xmlns:eCH-0046="http://www.ech.ch/xmlns/eCH-0046/6" xmlns:eCH-0108="http://www.ech.ch/xmlns/eCH-0108/7" xmlns:eCH-0129="http://www.ech.ch/xmlns/eCH-0129/6" xmlns:eCH-0276="http://www.ech.ch/xmlns/eCH-0276/1" targetNamespace="http://www.ech.ch/xmlns/eCH-0276/1" elementFormDefault="qualified" attributeFormDefault="unqualified" version="0">
	<xs:annotation>
		<xs:documentation xml:lang="de">SSK E-Bilanz und E-Tax JP</xs:documentation>
	</xs:annotation>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0007/6" schemaLocation="eCH-0007-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0010/8" schemaLocation="eCH-0010-8-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0046/6" schemaLocation="eCH-0046-6-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0108/7" schemaLocation="eCH-0108-7-0.xsd"/>
	<xs:import namespace="http://www.ech.ch/xmlns/eCH-0129/6" schemaLocation="eCH-0129-6-0.xsd"/>
	<!-- definition of simple types -->
	<!-- percentage type -->
	<xs:simpleType name="percentageType">
		<xs:restriction base="xs:decimal">
			<xs:maxInclusive value="100"/>
			<xs:minInclusive value="-100"/>
			<xs:fractionDigits value="4"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- choice of currencies -->
	<xs:simpleType name="currencyShareEquityType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="CHF"/>
			<xs:enumeration value="EUR"/>
			<xs:enumeration value="USD"/>
			<xs:enumeration value="GBP"/>
			<xs:enumeration value="JPY"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- currency -->
	<xs:simpleType name="currencyFinancialReportingType">
		<xs:restriction base="xs:string">
			<xs:length value="3"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- iban -->
	<xs:simpleType name="ibanType">
		<xs:restriction base="xs:string">
			<xs:pattern value="[C]{1}[H]{1}[0-9]{19}"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- tax adjustments increasing taxable result -->
	<xs:simpleType name="taxableResultIncreaseReasonDescriptionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="unjustifiedBusinessDepreciationAndCostsForAcquisitionProductionOrIncreaseInValueOfAsset"/>
			<xs:enumeration value="provisionsNotSubstantiatedByBusiness"/>
			<xs:enumeration value="unallowableDepreciationOfRevaluedAssets"/>
			<xs:enumeration value="contributionsToReserves"/>
			<xs:enumeration value="concealedProfitDistributionsAndUnjustifiedPaymentsToThirdParties"/>
			<xs:enumeration value="excessiveGrants"/>
			<xs:enumeration value="insufficientInterest"/>
			<xs:enumeration value="excessiveInterest"/>
			<xs:enumeration value="bookprofitsFromHigherValuationOfRealEstateAndParticipations"/>
			<xs:enumeration value="otherTaxableIncomeNotCreditedToTheIncomeStatement"/>
			<xs:enumeration value="expensesNotJustifiedByBusiness"/>
			<xs:enumeration value="correctionOfTaxExpense"/>
			<xs:enumeration value="dissolutionOfTaxedHiddenNegativeReserves"/>
			<xs:enumeration value="nonDeductibleDepreciation"/>
			<xs:enumeration value="nonPeriodicExpensesToEnsureThePrincipleOfPeridiodicity"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- tax adjustments decreasing taxable result -->
	<xs:simpleType name="taxableResultDecreaseReasonDescriptionType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="reversalOfTaxedUndisclosedReserves"/>
			<xs:enumeration value="dissolutionOfDeclaredHiddenReserves"/>
			<xs:enumeration value="contributionsToPensionFundsForBenefitOfOwnStaff"/>
			<xs:enumeration value="voluntaryPaymentForExclusivelyCharitablePurposes"/>
			<xs:enumeration value="capitalDepositsSurchargePaymentsFondsPerdu"/>
			<xs:enumeration value="netProfitSubjectToPropertyGainsTaxMonisticSystem"/>
			<xs:enumeration value="otherNonTaxableIncomeCreditedToTheIncomeStatement"/>
			<xs:enumeration value="correctionOfTaxExpense"/>
			<xs:enumeration value="nonPeriodicIncomeToEnsureThePrincipleOfPeridiodicity"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- document type -->
	<xs:simpleType name="documentIdentificationType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="completeTaxDeclaration"/>
			<xs:enumeration value="balanceSheetIncomeStatementNotes"/>
			<xs:enumeration value="netBalance"/>
			<xs:enumeration value="notesToAnnualStatement"/>
			<xs:enumeration value="formPrimeCosts"/>
			<xs:enumeration value="taxSegregation"/>
			<xs:enumeration value="taxReturnOfTheCantonOfDomicile"/>
			<xs:enumeration value="auditReport"/>
			<xs:enumeration value="informationOnShareholdings"/>
			<xs:enumeration value="wageStatement"/>
			<xs:enumeration value="staf"/>
			<xs:enumeration value="accountSheet"/>
			<xs:enumeration value="offsettingLosses"/>
			<xs:enumeration value="hiddenEquity"/>
			<xs:enumeration value="properties"/>
			<xs:enumeration value="shareholdersAssociates"/>
			<xs:enumeration value="depreciation"/>
			<xs:enumeration value="financialAssets"/>
			<xs:enumeration value="taxableRecord"/>
			<xs:enumeration value="otherAttachments"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- type of Securities / Code -->
	<xs:simpleType name="typeOfSecurityCodeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="shares"/>
			<xs:enumeration value="capitalContributions"/>
			<xs:enumeration value="cooperativeShares"/>
			<xs:enumeration value="participationCertificates"/>
			<xs:enumeration value="profitParticipationCertificates"/>
			<xs:enumeration value="sharesInTheCapitalOfASicaf"/>
			<xs:enumeration value="othertypeOfSecurity"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Code patents / cantonal speciality-->
	<xs:simpleType name="percentageReductionInEquityTaxCodeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="participations"/>
			<xs:enumeration value="patentsAndComparableRights"/>
			<xs:enumeration value="loansToGroupCompanies"/>
			<xs:enumeration value="cantonalSpecialities"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Type of related Party -->
	<xs:simpleType name="typeOfRelatedPartyType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="shareholderNaturalPerson"/>
			<xs:enumeration value="shareholderLegalEntity"/>
			<xs:enumeration value="groupCompanies"/>
			<xs:enumeration value="subsidiaries"/>
			<xs:enumeration value="otherRelatedParties"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Type of object / property -->
	<xs:simpleType name="objectTypeType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="agriculturalProperties"/>
			<xs:enumeration value="singleFamilyHousesflatOwnershipForResidentialPurposes"/>
			<xs:enumeration value="multiFamilyAndCommercialBuildingsCondominiumsForBusinessPurposes"/>
			<xs:enumeration value="industrialOrCommercialProperties"/>
			<xs:enumeration value="otherPropertiesNotUsedForAgriculturalPurposes"/>
			<xs:enumeration value="undevelopedProperty"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Operating property or investment property -->
	<xs:simpleType name="operatingPropertyOrInvestmentPropertyType">
		<xs:restriction base="xs:string">
			<xs:enumeration value="operatingProperty"/>
			<xs:enumeration value="investmentProperty"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- textFieldType -->
	<xs:simpleType name="textFieldType">
		<xs:restriction base="xs:string">
			<xs:maxLength value="500"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- definition of complex types -->
	<xs:complexType name="assetsType">
		<xs:annotation>
			<xs:documentation xml:lang="en">assets (register A on forms)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="currentAssets" type="eCH-0276:currentAssetsType" minOccurs="0"/>
			<xs:element name="noncurrentAssets" type="eCH-0276:noncurrentAssetsType" minOccurs="0"/>
			<xs:element name="totalAssets" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="currentAssetsType">
		<xs:sequence>
			<xs:element name="cashAndCashEquivalentsAndCurrentAssetsWithStockMarketPrice" type="eCH-0276:cashAndCashEquivalentsAndCurrentAssetsWithStockMarketPriceType" minOccurs="0"/>
			<xs:element name="tradeAndOtherCurrentReceivables" type="eCH-0276:tradeAndOtherCurrentReceivablesType" minOccurs="0"/>
			<xs:element name="otherShortTermReceivables" type="eCH-0276:otherShortTermReceivablesType" minOccurs="0"/>
			<xs:element name="inventoriesAndWorkInProgress" type="eCH-0276:inventoriesAndWorkInProgressType" minOccurs="0"/>
			<xs:element name="accruedIncomeAndPrepaidExpenses" type="xs:long" minOccurs="0"/>
			<xs:element name="totalCurrentAssets" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="cashAndCashEquivalentsAndCurrentAssetsWithStockMarketPriceType">
		<xs:sequence>
			<xs:element name="cashAndCashEquivalents" type="xs:long" minOccurs="0"/>
			<xs:element name="currentAssetsWithStockMarketPrice" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tradeAndOtherCurrentReceivablesType">
		<xs:sequence>
			<xs:element name="tradeReceivablesPayableByThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="tradeReceivablesPayableByParticipations" type="xs:long" minOccurs="0"/>
			<xs:element name="tradeReceivablesPayableByParticipantsAndManagingOfficers" type="xs:long" minOccurs="0"/>
			<xs:element name="valueAdjustmentTradeAndOtherCurrentReceivables" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="otherShortTermReceivablesType">
		<xs:sequence>
			<xs:element name="otherShortTermReceivablesPayableByThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="otherShortTermReceivablesPayableByParticipations" type="xs:long" minOccurs="0"/>
			<xs:element name="otherShortTermReceivablesPayableByParticipationsAndManagingOfficers" type="xs:long" minOccurs="0"/>
			<xs:element name="downPaymentAdvancePaymentsToSuppliers" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="inventoriesAndWorkInProgressType">
		<xs:sequence>
			<xs:element name="inventories" type="xs:long" minOccurs="0"/>
			<xs:element name="valueAdjustmentInventories" type="xs:long" minOccurs="0"/>
			<xs:element name="workInProgress" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="noncurrentAssetsType">
		<xs:sequence>
			<xs:element name="financialAssets" type="eCH-0276:financialAssetsType" minOccurs="0"/>
			<xs:element name="participations" type="xs:long" minOccurs="0"/>
			<xs:element name="propertyPlantEquipment" type="eCH-0276:propertyPlantEquipmentType" minOccurs="0"/>
			<xs:element name="intangibleAssets" type="eCH-0276:intangibleAssetsType" minOccurs="0"/>
			<xs:element name="unpaidShareCapital" type="xs:long" minOccurs="0"/>
			<xs:element name="totalNoncurrentAssets" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="financialAssetsType">
		<xs:sequence>
			<xs:element name="longTermSecurities" type="xs:long" minOccurs="0"/>
			<xs:element name="otherFinancialAssets" type="xs:long"/>
			<xs:element name="longTermThirdPartyReceivables" type="xs:long" minOccurs="0"/>
			<xs:element name="longTermAffiliatesReceivables" type="xs:long" minOccurs="0"/>
			<xs:element name="longTermShareholdersReceivables" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="propertyPlantEquipmentType">
		<xs:sequence>
			<xs:element name="machinery" type="xs:long" minOccurs="0"/>
			<xs:element name="furnitureAndOfficeEquipment" type="xs:long" minOccurs="0"/>
			<xs:element name="officeEquipmentItAndCommunicationsTechnology" type="xs:long" minOccurs="0"/>
			<xs:element name="vehicles" type="xs:long" minOccurs="0"/>
			<xs:element name="toolsAndEquipment" type="xs:long" minOccurs="0"/>
			<xs:element name="otherMobileTangibleAssets" type="xs:long" minOccurs="0"/>
			<xs:element name="fixedTangibleAssets" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="intangibleAssetsType">
		<xs:sequence>
			<xs:element name="licencesPatents" type="xs:long" minOccurs="0"/>
			<xs:element name="goodwill" type="xs:long" minOccurs="0"/>
			<xs:element name="otherIntangibleAssets" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="equityAndLiabilitiesType">
		<xs:annotation>
			<xs:documentation xml:lang="en">equityAndLiabilities (register B on forms)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="currentLiabilities" type="eCH-0276:currentLiabilitiesType" minOccurs="0"/>
			<xs:element name="noncurrentLiabilities" type="eCH-0276:noncurrentLiabilitiesType" minOccurs="0"/>
			<xs:element name="fundCapitalEarmarked" type="xs:long" minOccurs="0"/>
			<xs:element name="totalFundCapitalEarmarked" type="xs:long" minOccurs="0"/>
			<xs:element name="equity" type="eCH-0276:equityType" minOccurs="0"/>
			<xs:element name="totalEquityAndLiabilities" type="xs:long" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="currentLiabilitiesType">
		<xs:sequence>
			<xs:element name="tradeAndOtherCurrentPayables" type="eCH-0276:tradeAndOtherCurrentPayablesType" minOccurs="0"/>
			<xs:element name="currentInterestBearingLiabilities" type="eCH-0276:currentInterestBearingLiabilitiesType" minOccurs="0"/>
			<xs:element name="otherCurrentLieabilitiesIntrestFree" type="eCH-0276:otherCurrentLieabilitiesIntrestFreeType" minOccurs="0"/>
			<xs:element name="accruedExpenses" type="xs:long" minOccurs="0"/>
			<xs:element name="currentProvisions" type="xs:long" minOccurs="0"/>
			<xs:element name="totalCurrentLiabilities" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="tradeAndOtherCurrentPayablesType">
		<xs:sequence>
			<xs:element name="currentPayablesThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="prepayments" type="xs:long" minOccurs="0"/>
			<xs:element name="currentPayablesAffiliates" type="xs:long" minOccurs="0"/>
			<xs:element name="currentPayablesShareholders" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="currentInterestBearingLiabilitiesType">
		<xs:sequence>
			<xs:element name="currentInterestBearingLiabilitiesThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="currentInterestBearingLiabilitiesAffiliates" type="xs:long" minOccurs="0"/>
			<xs:element name="currentInterestBearingLiabilitiesShareholders" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="otherCurrentLieabilitiesIntrestFreeType">
		<xs:sequence>
			<xs:element name="otherCurrentLieabilitiesIntrestFreeThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="otherCurrentLieabilitiesIntrestFreeAffiliates" type="xs:long" minOccurs="0"/>
			<xs:element name="otherCurrentLieabilitiesIntrestFreeShareholders" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="noncurrentLiabilitiesType">
		<xs:sequence>
			<xs:element name="noncurrentInterestBearingLiabilities" type="eCH-0276:noncurrentInterestBearingLiabilitiesType" minOccurs="0"/>
			<xs:element name="otherNoncurrentLieabilitiesIntrestFree" type="eCH-0276:otherNoncurrentLieabilitiesIntrestFreeType" minOccurs="0"/>
			<xs:element name="provisionsAndSimilarItemsStipulatedByLaw" type="eCH-0276:provisionsAndSimilarItemsStipulatedByLawType" minOccurs="0"/>
			<xs:element name="totalNoncurrentLiabilities" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="noncurrentInterestBearingLiabilitiesType">
		<xs:sequence>
			<xs:element name="noncurrentInterestBearingLiabilitiesThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="noncurrentInterestBearingLiabilitiesAffiliates" type="xs:long" minOccurs="0"/>
			<xs:element name="noncurrentInterestBearingLiabilitiesShareholders" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="otherNoncurrentLieabilitiesIntrestFreeType">
		<xs:sequence>
			<xs:element name="otherNoncurrentLieabilitiesIntrestFreeThirdParties" type="xs:long" minOccurs="0"/>
			<xs:element name="otherNoncurrentLieabilitiesIntrestFreeAffiliates" type="xs:long" minOccurs="0"/>
			<xs:element name="otherNoncurrentLieabilitiesIntrestFreeShareholders" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="provisionsAndSimilarItemsStipulatedByLawType">
		<xs:sequence>
			<xs:element name="guaranteeProvisions" type="xs:long" minOccurs="0"/>
			<xs:element name="provisionForMajorRepairs" type="xs:long" minOccurs="0"/>
			<xs:element name="provisionsForResearchAndDevelopment" type="xs:long" minOccurs="0"/>
			<xs:element name="provisionForRestructuringAndEnvironmentalProtection" type="xs:long" minOccurs="0"/>
			<xs:element name="provisionForTaxes" type="xs:long" minOccurs="0"/>
			<xs:element name="otherProvisions" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="equityType">
		<xs:sequence>
			<xs:element name="shareCapitalShareholderCapitalAssociationCapitalFoundationCapital" type="xs:long" minOccurs="1"/>
			<xs:element name="voluntaryProfitReservesAssociationFoundation" type="eCH-0276:voluntaryProfitReservesAssociationFoundationType" minOccurs="0"/>
			<xs:element name="statuatoryCapitalReserveLimitedCompanies" type="eCH-0276:statuatoryCapitalReserveLimitedCompaniesType" minOccurs="0"/>
			<xs:element name="statutoryProfitReserveLimitedCompanies" type="eCH-0276:statutoryProfitReserveLimitedCompaniesType" minOccurs="0"/>
			<xs:element name="voluntaryProfitReservesLimitedCompanies" type="eCH-0276:voluntaryProfitReservesLimitedCompaniesType" minOccurs="0"/>
			<xs:element name="ownCapitalShares" type="eCH-0276:ownCapitalSharesType" minOccurs="0"/>
			<xs:element name="netProfitOrLoss" type="eCH-0276:netProfitOrLossType" minOccurs="0"/>
			<xs:element name="totalEquity" type="xs:long" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="voluntaryProfitReservesAssociationFoundationType">
		<xs:sequence>
			<xs:element name="tiedCapitalFreeFundsCommercialLaw" type="xs:long" minOccurs="0"/>
			<xs:element name="freeCapitalReservesCommercialLaw" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="statuatoryCapitalReserveLimitedCompaniesType">
		<xs:sequence>
			<xs:element name="statuatoryCapitalReserveLimitedCompaniesAmount" type="xs:long" minOccurs="0"/>
			<xs:element name="capitalDepositReserve" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="statutoryProfitReserveLimitedCompaniesType">
		<xs:sequence>
			<xs:element name="statutoryProfitReserveLimitedCompaniesAmount" type="xs:long" minOccurs="0"/>
			<xs:element name="revaluationReserve" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="voluntaryProfitReservesLimitedCompaniesType">
		<xs:sequence>
			<xs:element name="voluntaryProfitReservesLimitedCompaniesAmount" type="xs:long" minOccurs="0"/>
			<xs:element name="exchangeDifferencesFunctionalCurrencyTechnical" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="ownCapitalSharesType">
		<xs:sequence>
			<xs:element name="ownCapitalSharesAsNegativeItem" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="netProfitOrLossType">
		<xs:sequence>
			<xs:element name="profitOrLossBroughtForward" type="xs:long" minOccurs="0"/>
			<xs:element name="interimDividendDistribution" type="xs:long" minOccurs="0"/>
			<xs:element name="contributionToStatutoryRetainedEarningFromInterimProfit" type="xs:long" minOccurs="0"/>
			<xs:element name="contributionToVoluntaryRetainedEarningFromInterimProfit" type="xs:long" minOccurs="0"/>
			<xs:element name="annualProfitOrAnnualLoss" type="xs:long" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="incomeStatementType">
		<xs:annotation>
			<xs:documentation xml:lang="en">incomeStatement (register C on forms)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="deliveriesAndServicesRevenue" type="eCH-0276:deliveriesAndServicesRevenueType" minOccurs="0"/>
			<xs:element name="revenueReductionsProductionTradeServices" type="xs:long" minOccurs="0"/>
			<xs:element name="associationsAndFoundations" type="eCH-0276:associationsAndFoundationsType" minOccurs="0"/>
			<xs:element name="totalOperatingRevenueFromDeliveriesAndServices" type="xs:long" minOccurs="0"/>
			<xs:element name="expenses" type="eCH-0276:expensesType" minOccurs="0"/>
			<xs:element name="depreciationValueAdjustmentNoncurrentAssets" type="eCH-0276:depreciationValueAdjustmentNoncurrentAssetsType" minOccurs="0"/>
			<xs:element name="financialExpensesAndFinancialIncome" type="eCH-0276:financialExpensesAndFinancialIncomeType" minOccurs="0"/>
			<xs:element name="profitOtherOperatingAncillaryBusiness" type="eCH-0276:profitOtherOperatingAncillaryBusinessType" minOccurs="0"/>
			<xs:element name="externalExpensesAndExternalIncome" type="eCH-0276:externalExpensesAndExternalIncomeType" minOccurs="0"/>
			<xs:element name="externalExtraordinaryOneoffOrNonperiodicExpensesAndIncome" type="eCH-0276:externalExtraordinaryOneoffOrNonperiodicExpensesAndIncomeType" minOccurs="0"/>
			<xs:element name="fundPerformance" type="eCH-0276:fundPerformanceType" minOccurs="0"/>
			<xs:element name="directTaxes" type="xs:long" minOccurs="0"/>
			<xs:element name="annualProfitOrAnnualLoss" type="xs:long" minOccurs="1"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="deliveriesAndServicesRevenueType">
		<xs:sequence>
			<xs:element name="productionRevenue" type="xs:long" minOccurs="0"/>
			<xs:element name="tradeRevenue" type="xs:long" minOccurs="0"/>
			<xs:element name="serviceRevenue" type="xs:long" minOccurs="0"/>
			<xs:element name="otherOperatingRevenue" type="xs:long" minOccurs="0"/>
			<xs:element name="publicSectorContributions" type="xs:long" minOccurs="0"/>
			<xs:element name="ownWork" type="xs:long" minOccurs="0"/>
